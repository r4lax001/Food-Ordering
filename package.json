{
  "name": "food-ordering-reservation-service",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Restaurant ordering and reservation REST API",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "frontend:dev": "npm --prefix frontend run dev",
    "frontend:build": "npm --prefix frontend run build",
    "dev": "node --watch src/server.js",
    "start": "node src/server.js",
    "db:setup": "node scripts/setup-db.js",
    "db:local": "node scripts/local-mysql.js",
    "db:stop": "node scripts/local-mysql.js stop",
    "admin:create": "node scripts/create-admin.js",
    "test": "node --test test/unit.test.js",
    "test:integration": "node --test test/integration.test.js test/auth.integration.test.js",
    "test:postman": "node scripts/test-postman.js"
  },
  "dependencies": {
    "bcrypt": "^6.0.0",
    "cors": "^2.8.6",
    "dotenv": "^17.2.3",
    "express": "^5.1.0",
    "express-rate-limit": "^8.1.0",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.3",
    "mysql2": "^3.15.3",
    "zod": "^4.1.12"
  }
}
