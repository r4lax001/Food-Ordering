{
  "info": {
    "name": "Food Ordering & Reservation Web Service",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Run in order with Local environment. Creates a test customer and cancelled orders. Requires seeded database and admin credentials."
  },
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "if (pm.info.requestName === '01 Health: MySQL connection') {",
          "  pm.environment.set('run_id', Date.now().toString() + Math.random().toString(36).slice(2, 6));",
          "  pm.environment.set('booking_date', new Date(Date.now() + 7*86400000).toISOString().slice(0,10));",
          "}"
        ]
      }
    }
  ],
  "item": [
    {
      "name": "01 Health: MySQL connection",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{base_url}}/api/health"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
              "pm.test('Database connected', () => pm.expect(pm.response.json().database).to.eql('connected'));"
            ]
          }
        }
      ]
    },
    {
      "name": "02 GET menu from MySQL",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{base_url}}/api/menu"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
              "pm.test('Menu is an array', () => pm.expect(pm.response.json().data).to.be.an('array'));"
            ]
          }
        }
      ]
    },
    {
      "name": "03 Categories",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Content-Type",
