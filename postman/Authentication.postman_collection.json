              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
              "if (pm.response.code === 200) pm.environment.set('token', pm.response.json().token);",
              "pm.test('JWT returned', () => pm.expect(pm.response.json().token.split('.')).to.have.lengthOf(3));",
              "pm.test('No password hash', () => pm.expect(pm.response.json().user).not.to.have.property('password_hash'));"
            ]
          }
        }
      ]
    },
