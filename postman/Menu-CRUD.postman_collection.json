{
  "info": {
    "name": "Step 3 - Menu CRUD",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Run all requests in order with Food Service Local environment. Requires seeded categories and admin credentials. DELETE is soft delete."
  },
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "if (pm.info.requestName === '01 Login admin') pm.environment.set('run_id', Date.now().toString());"
        ]
      }
    }
  ],
  "item": [
    {
      "name": "01 Login admin",
      "request": {
        "method": "POST",
        "url": "{{base_url}}/api/auth/login",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"{{admin_email}}\",\n  \"password\": \"{{admin_password}}\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
              "if (pm.response.code === 200) pm.environment.set('admin_token', pm.response.json().token);"
            ]
          }
        }
      ]
    },
    {
      "name": "02 GET menu list",
      "request": {
        "method": "GET",
        "url": "{{base_url}}/api/menu",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ]
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
              "pm.test('Menu array', () => pm.expect(pm.response.json().data).to.be.an('array'));"
            ]
          }
        }
      ]
    },
    {
      "name": "03 POST create menu",
      "request": {
        "method": "POST",
        "url": "{{base_url}}/api/menu",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Authorization",
            "value": "Bearer {{admin_token}}"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"category_id\": 1,\n  \"name\": \"Menu CRUD {{run_id}}\",\n  \"description\": \"Postman test menu\",\n  \"price\": 65.5,\n  \"is_available\": true\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 201', () => pm.response.to.have.status(201));",
              "if (pm.response.code === 201) pm.environment.set('menu_id', pm.response.json().data.id);"
            ]
          }
        }
      ]
    },
    {
      "name": "04 GET menu detail",
      "request": {
        "method": "GET",
        "url": "{{base_url}}/api/menu/{{menu_id}}",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ]
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
              "pm.test('Inserted price', () => pm.expect(pm.response.json().data.price).to.eql('65.50'));"
            ]
          }
        }
      ]
    },
    {
      "name": "05 PUT update menu",
      "request": {
        "method": "PUT",
        "url": "{{base_url}}/api/menu/{{menu_id}}",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Authorization",
            "value": "Bearer {{admin_token}}"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"category_id\": 1,\n  \"name\": \"Updated menu {{run_id}}\",\n  \"description\": \"Postman test menu\",\n  \"price\": 80,\n  \"is_available\": true\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 200', () => pm.response.to.have.status(200));"
            ]
          }
        }
      ]
    },
    {
      "name": "06 GET updated menu",
